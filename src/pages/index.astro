---
import Layout from "../layouts/Layout.astro";
import { socials } from "../data/socials.ts";
import { getFeaturedWorks } from "../lib/featured";
const works = await getFeaturedWorks();

const projects = [
  {
    category: "Programming",
    title: "CommandBeep",
    description:
      "A Command Palette Extension for Beeper Messager, backed with Beeper Desktop API + OAuth 2.0 PKCE",
    image: "/assets/commandbeep.png",
  },
  {
    category: "UI/UX",
    title: "Omah Lamita",
    description:
      "A website concept for Malang-based MSME, in collaboration with TFI.",
  },
  {
    category: "Graphic Design",
    title: "HMFI Lanyard",
    description:
      "A lanyard for a student focused, Indonesian based, furry fandom community.",
  },
  {
    category: "Programming",
    title: "Phonecho",
    description:
      "A ridiculously simple, offline, browser-based NATO phonetics game.",
  },
];
---

<Layout title="Reuben Hu">
  <section class="jumbo gap-12">
    <div class="md:h-48 overflow-hidden border-neutral-50 border-2">
      <img
        class="size-full object-cover"
        src="/assets/intro.jpg"
        alt="Portrait of Reuben Hu"
        width="300"
        height="192"
      />
    </div>
    <div class="flex flex-col gap-4">
      <h1>
        Student, Builder, and Creator. <br />
        <!-- <i>For the Good of People.</i> -->
      </h1>
      <p>
        I'm Reuben Hu, a computer science student at BINUS University.
        <br />A self-taught learner in Linux and networking, and an occasional
        open-source contributor.
      </p>
      <ul class="flex list-none gap-3">
        {socials.map((social) => (
          <li>
            <a href={social.href} aria-label={social.name} target="_blank">
              <span>
                <img
                  class="size-8"
                  src={social.icon}
                  alt={social.name}
                  width="64"
                  height="64"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="gap-6 overflow-hidden border-b border-neutral-700 px-6 py-9 md:px-36">
    <div class="flex flex-col gap-4">
      <h1>My Works</h1>
      <p>
        Building one step at a time.{" "}
        <a class="text-teal-300 underline" href="#portfolio">
          See more here.
        </a>
      </p>
    </div>
    <div class="flex w-full flex-col gap-6 md:flex-row">
      {works.map((w) => (
        <article class="flex min-w-0 flex-1 flex-col gap-2.5 overflow-hidden">
          <div class="aspect-video w-full overflow-hidden">
            <img
              class="size-full object-cover"
              src={w.data.cover.src}
              alt={w.data.coverAlt}
              width="300"
              height="1300"
            />
          </div>
          <p class="overflow-hidden text-xs font-bold text-ellipsis whitespace-nowrap">
            {w.data.type}
          </p>
          <a href={w.filePath}>
            <h2 class="overflow-hidden text-ellipsis whitespace-nowrap">
              {w.data.title}
            </h2>
          </a>
          <p class="line-clamp-3">{w.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
