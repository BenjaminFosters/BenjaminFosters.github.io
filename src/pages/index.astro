---
import Layout from "../layouts/Layout.astro";
import { socials } from "../data/socials.ts";
import { getFeaturedWorks } from "../lib/featured";
const works = await getFeaturedWorks();
import { CustomIcons, type IconName } from "../lib/icons.ts";
---

<Layout title="Reuben Hu" description="A website of Reuben Hu">
  <section class="jumbo gap-12">
    <div class="md:h-48 overflow-hidden border-neutral-50 border-2">
      <img
        class="size-full object-cover"
        src="/assets/intro.jpg"
        alt="Portrait of Reuben Hu"
        width="300"
        height="192"
      />
    </div>
    <div class="flex flex-col gap-4">
      <h1>
        Student, Builder, and Creator. <br />
        <!-- <i>For the Good of People.</i> -->
      </h1>
      <p>
        I'm Reuben Hu, a computer science student at BINUS University.
        <br />A self-taught learner in Linux and networking, and an occasional
        open-source contributor.
      </p>
      <ul class="flex list-none gap-3">
        {socials.map((social) => (
          <li>
            <a
              href={social.href}
              aria-label={social.name}
              target="_blank"
              rel="noopener noreferrer"
              class="no-underline"
            >
              <span>
                <span
                  class="inline-flex h-10 w-10 [&>svg]:h-full [&>svg]:w-full"
                  aria-hidden="true"
                  set:html={CustomIcons[social.name.toLowerCase()]}
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="gap-6 overflow-hidden border-b border-neutral-700 px-6 py-9 md:px-36">
    <div class="flex flex-col gap-4">
      <h1>My Works</h1>
      <p>
        Building one step at a time. <a href="#portfolio">See more here.</a>
      </p>
    </div>
    <div class="flex w-full flex-col gap-6 md:flex-row">
      {works.map((work) => (
        <article class="flex min-w-0 flex-1 flex-col gap-2.5 overflow-hidden">
          <a
            class="aspect-video w-full overflow-hidden"
            href={`/works/${work.id}`}
          >
            <img
              class="size-full object-cover"
              src={work.data.cover.src}
              alt={work.data.coverAlt}
              width={work.data.cover.width}
              height={work.data.cover.height}
            />
          </a>
          <p class="overflow-hidden text-xs font-bold text-ellipsis whitespace-nowrap">
            {work.data.type}
          </p>
          <a href={`/works/${work.id}`} class="no-underline">
            <h2 class="overflow-hidden text-ellipsis whitespace-nowrap">
              {work.data.title}
            </h2>
          </a>
          <p class="line-clamp-3">{work.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
