---
import Layout from "../layouts/Layout.astro";
import { socials } from "../data/socials.ts";

const projects = [
  {
    category: "Programming",
    title: "CommandBeep",
    description:
      "A Command Palette Extension for Beeper Messager, backed with Beeper Desktop API + OAuth 2.0 PKCE",
    image: "/assets/commandbeep.png",
  },
  {
    category: "UI/UX",
    title: "Omah Lamita",
    description:
      "A website concept for Malang-based MSME, in collaboration with TFI.",
  },
  {
    category: "Graphic Design",
    title: "HMFI Lanyard",
    description:
      "A lanyard for a student focused, Indonesian based, furry fandom community.",
  },
  {
    category: "Programming",
    title: "Phonecho",
    description:
      "A ridiculously simple, offline, browser-based NATO phonetics game.",
  },
];
---

<Layout title="Reuben Hu">
  <section
    id="home"
    class="flex w-full flex-col items-start justify-between gap-12 overflow-hidden border-b border-neutral-700 px-6 py-18 md:flex-row md:items-center md:px-36"
  >
    <div class="flex flex-col gap-4">
      <h1>#OpenToFoster Since 2007</h1>
      <p>
        <strong>Computer Science Student</strong>, who just happen to be a
        <strong>system tinkerer</strong> & a <strong>creative person</strong>.
      </p>
      <ul class="flex list-none gap-3">
        {
          socials.map((social) => (
            <li>
              <a href={social.href} aria-label={social.name}>
                <span>
                  <img
                    class="size-8"
                    src={social.icon}
                    alt={social.name}
                    width="64"
                    height="64"
                  />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="h-48 w-[300px] shrink-0 overflow-hidden border-[3px] border-neutral-50"
    >
      <img
        class="size-full object-cover"
        src="/assets/intro.jpg"
        alt="Portrait of Reuben Hu"
        width="300"
        height="192"
      />
    </div>
  </section>

  <section
    id="portfolio"
    class="flex w-full flex-col gap-[18px] overflow-hidden border-b border-neutral-700 px-6 py-9 md:px-36"
  >
    <div class="flex flex-col gap-4">
      <h1>My Works</h1>
      <p>
        Talk is Cheap, here’s my <strong>programs</strong>, and <strong
          >designs</strong
        >.&nbsp
        <a class="text-teal-300 underline" href="#portfolio">
          See more here, pamcakes included.</a
        >
      </p>
    </div>
    <div class="flex w-full flex-col gap-6 md:flex-row">
      {
        projects.map((project) => (
          <article class="flex min-w-0 flex-1 flex-col gap-2.5 overflow-hidden">
            {project.image ? (
              <div class="h-36 w-full overflow-hidden">
                <img
                  class="size-full object-cover"
                  src={project.image}
                  alt=""
                  width="300"
                  height="144"
                />
              </div>
            ) : (
              <div class="h-36 w-full bg-neutral-500" />
            )}
            <p class="overflow-hidden text-xs font-bold text-ellipsis whitespace-nowrap">
              {project.category}
            </p>
            <h2 class="overflow-hidden text-ellipsis whitespace-nowrap">
              {project.title}
            </h2>
            <p class="line-clamp-3">{project.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
